# Copy this file to ".env" (git-ignored, never committed) and fill in the
# real values below. For Vercel deployment, add the same VITE_FIREBASE_*
# variables in Project → Settings → Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Reference only — not read by the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
